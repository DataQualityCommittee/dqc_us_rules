rule-name-prefix DQC

/** V30 Release **/

Assert US.0246.10948 satisfied

$rule_id = (rule-name().split('.'))[rule-name().split('.').length];

/** This rule checks that the security name is UNIQUE for the investment identifier on a SOI 

1. Need to get the value up to the first |.  Then ensure that this value is unique for each investment identifier.  Need to add them to a list and identify if duplicates exist.  If no | then the rule does not run.**/

$BDC_IOAC_FACTS = list([covered @concept = InvestmentOwnedAtCost @InvestmentIdentifierAxis = *])
$DIM_Members = (filter  $BDC_IOAC_FACTS returns $item.dimension(InvestmentIdentifierAxis))

$KEYED_Value = filter $DIM_Members where $item.contains("|") returns $item

true

message
"
.

Rule Element Id:{$rule_id}
Rule version: {$ruleVersion}"

severity error  
effectiveDate $effective_dates[$rule_id]

