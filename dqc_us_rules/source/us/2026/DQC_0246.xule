    $IOAC = [@concept = InvestmentOwnedAtCost @InvestmentIdentifierAxis = $DIM @unit];
    $TYP = [@concept = InvestmentTypeExtensibleEnumeration @InvestmentIdentifierAxis = $DIM @unit]
