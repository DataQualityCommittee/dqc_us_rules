ASSERT US.0246.10746 SATISFIED

/** Check to make sure an extensible enumeration value for the InvestmentIndustrySectorExtensibleEnumeration is used.
**/

$rule_id = (rule-name().split('.'))[rule-name().split('.').length];

/** DQCRT RULE **/
if not applicable_form(rule-name())
	skip
else

/** Get list of all investments 

$BDC_IOAC_FACTS = list([covered @concept = InvestmentOwnedAtCost @InvestmentIdentifierAxis = *])
$DIM_Members = (filter  $BDC_IOAC_FACTS returns $item.dimension(InvestmentIdentifierAxis)).to-set **/

for $DIM in $DIM_MEMBERS.to-set
    $IOAC = [@concept = InvestmentOwnedAtCost @InvestmentIdentifierAxis = $DIM @unit];
    $AFF = [@concept = InvestmentIssuerAffiliationExtensibleEnumeration @InvestmentIdentifierAxis = $DIM @unit]
    exists($IOAC) and (missing($AFF) and get_dim_key_value($DIM, "AFF") == none)


