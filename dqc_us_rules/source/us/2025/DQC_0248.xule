Taxonomy: US GAAP 2024
**/


rule-name-prefix DQC

/** V31 Release **/

Assert US.0248.10960 satisfied

$rule_id = (rule-name().split('.'))[rule-name().split('.').length];

/** Check if an 11-K filing then the cover page should be tagged to a member on the LegalEntityAxis. All of the following MUST be tagged DocumentType and AmendmentFlag.
**/

$EBPReports = set('11-K','11-K/A','11-KT').contains([covered @concept.local-name ='DocumentType']);

If $EBPReports
    $documentTypeWithMemberExists = list([@concept.local.name = 'DocumentType' @dei:LegalEntityAxis = *]);
    $AmendmentFlagWithMemberExists = list([@concept.local.name = 'AmendmentFlag' @dei:LegalEntityAxis = *]);

    if $documentTypeWithMemberExists.length == 0 
        $message1 = "The filing is an 11-K filing and the DocumentType element has NOT been tagged with a member on the LegalEntityAxis."
        if $AmendmentFlagWithMemberExists.length == 0
            $message2 = "In addition the AmendmentFlag element has NOT been tagged with a member on the LegalEntityAxis."
            true
        else
            $message2 = "";
            true
    else
        if $AmendmentFlagWithMemberExists.length == 0
            $message1 = "";
            $message2 = "The filing is an 11-K filing and the AmendmentFlag element has NOT been tagged with a member on the LegalEntityAxis."
            true
        else
            $message1 = "";
            $message2 = "";
            false
else
    skip

message
"
{$message1} {$message2} The SEC guidance for 11-K filings is that the cover page should be tagged to a member on the LegalEntityAxis.  Please tag the DocumentType and AmendmentFlag elements with a member on the LegalEntityAxis. See section 3.2.7 of the SEC EDGAR XBRL Guide for guidance on tagging the cover page of 11-K filings.

Rule Element Id:{$rule_id}
Rule version: {$ruleVersion}"

severity error  
effectiveDate $effective_dates[$rule_id]

