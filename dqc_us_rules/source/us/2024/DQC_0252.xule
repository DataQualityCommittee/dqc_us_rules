/** Returns the cubes for the given table used in a statement section that is not parenthetical **/
function soi_statement_cubes($tableName)
	filter taxonomy().cubes where $item.cube-concept.name == $tableName
		and $item.drs-role.description.contains('- Statement -')
		and (not $item.drs-role.uri.lower-case.contains('parenthetical'))
